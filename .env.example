# Server Configuration
NODE_ENV=development
PORT=5000
# Database
MONGODB_URI=mongodb://localhost:27017/ura_dev
DB_NAME=ura_dev

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Apple
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# AWS (for S3 uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# App
APP_URL=http://localhost:5000

# Email Configuration
# Mailtrap (for development/testing)
# Get your token from: https://mailtrap.io/api-tokens
MAILTRAP_TOKEN=your_mailtrap_api_token
# Get template UUID from Mailtrap dashboard (optional, for welcome emails)
MAILTRAP_TEMPLATE_UUID=your_mailtrap_template_uuid

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# PAYLUK Configuration
PAYLUK_API_BASE=
PAYLUK_SECRET_KEY=
PAYLUK_WEBHOOK_SECRET=
# Comma-separated Payluk escrow statuses that count as "paid" (confirm with Payluk)
PAYLUK_PAID_STATUSES=ongoing,paid,success,successful,completed,funded

# Frontend / email / delivery
FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
FEZ_BASE_URL=
FEZ_USER_ID=
FEZ_PASSWORD=

# Retail Media Network (ura-rmn) — ad server. Leave empty to disable ads.
RMN_API_BASE=
RMN_SERVE_API_SECRET=
RMN_STORE_MAP=
RMN_TIMEOUT_MS=